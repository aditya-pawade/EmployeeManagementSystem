<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            @Html.ActionLink(
                "PeopleDesk", "Index", "Home",
                null, new { @class = "navbar-brand" })

            @if (Session["AccountId"] != null)
            {
                <button class="navbar-toggler"
                        type="button"
                        data-toggle="collapse"
                        data-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            @Html.ActionLink(
                                "Dashboard", "Index", "Home",
                                null, new { @class = "nav-link" })
                        </li>

                        @if (Session["Role"] as string == "Admin")
                        {
                            <li class="nav-item">
                                @Html.ActionLink(
                                    "Employees", "Index", "Work",
                                    null, new { @class = "nav-link" })
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink(
                                    "Add Employee", "CreateEmployee", "Work",
                                    null, new { @class = "nav-link" })
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                @Html.ActionLink(
                                    "My Profile", "MyProfile", "Work",
                                    null, new { @class = "nav-link" })
                            </li>
                        }

                        <li class="nav-item">
                            @using (Html.BeginForm(
                                "Logout", "Account",
                                FormMethod.Post,
                                new { @class = "form-inline" }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-light ml-2">
                                    Sign out
                                </button>
                            }
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <main class="container body-content">
        @RenderBody()
    </main>

    <footer class="container">
        <hr />
        <p class="text-muted">
            &copy; @DateTime.Now.Year PeopleDesk
            · Employee Management System
        </p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
