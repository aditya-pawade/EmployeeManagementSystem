@model EmployeeManagementSystem_CodeFirstApproach_.Models.Employee

@{
    ViewBag.Title = "Add Employee";
}

<div class="page-heading">
    <div>
        <h2>Add Employee</h2>
        <p class="text-muted">Enter the employee information below.</p>
    </div>
</div>

<div class="panel-card form-card">
    @using (Html.BeginForm("CreateEmployee", "Work",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
                 true, "", new { @class = "text-danger" })

        @Html.Partial("_EmployeeForm", Model)

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Save Employee
            </button>

            @Html.ActionLink("Cancel", "Index", "Work",
                     null, new { @class = "btn btn-light" })
        </div>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}