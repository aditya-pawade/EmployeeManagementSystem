@model EmployeeManagementSystem_CodeFirstApproach_.Models.Employee

@{
    ViewBag.Title = "Edit Employee";
}

<div class="page-heading">
    <div>
        <h2>Edit Employee</h2>
        <p class="text-muted">
            Update record #@Model.EmployeeId.
        </p>
    </div>
</div>

<div class="panel-card form-card">
    @using (Html.BeginForm("UpdateEmployee", "Work",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EmployeeId)

        @Html.ValidationSummary(
                 true, "", new { @class = "text-danger" })

        @Html.Partial("_EmployeeForm", Model)

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            @Html.ActionLink("Cancel", "Index", "Work",
                     null, new { @class = "btn btn-light" })
        </div>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}