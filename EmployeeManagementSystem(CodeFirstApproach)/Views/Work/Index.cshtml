@model IEnumerable<EmployeeManagementSystem_CodeFirstApproach_.Models.Employee>

@{
    ViewBag.Title = "Employees";
}

<div class="page-heading">
    <div>
        <h2>Employee Directory</h2>
        <p class="text-muted">
            Search and manage employee records.
        </p>
    </div>

    @Html.ActionLink(
            "+ Add Employee",
            "CreateEmployee",
            "Work",
            null,
            new { @class = "btn btn-primary" })
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}

<div class="panel-card">
    @using (Html.BeginForm("Index", "Work",
        FormMethod.Get, new { @class = "search-form" }))
    {
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search name, email or designation..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        @Html.ActionLink("Clear", "Index", null,
                 new { @class = "btn btn-light" })
    }

    <div class="table-responsive">
        <table class="table employee-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Email</th>
                    <th>Salary</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>#@employee.EmployeeId</td>
                        <td>
                            <strong>@employee.EmployeeName</strong>
                        </td>
                        <td>@employee.EmployeeDepatment</td>
                        <td>@employee.EmployeeDesignation</td>
                        <td>@employee.EmployeeEmail</td>
                        <td>
                            @employee.EmployeeSalary.ToString("N2")
                        </td>
                        <td class="action-cell">
                            @Html.ActionLink(
                                     "View", "Details", "Work",
                                     new { id = employee.EmployeeId },
                                     new { @class = "btn btn-sm btn-light" })

                            @Html.ActionLink(
                                     "Edit", "UpdateEmployee", "Work",
                                     new { id = employee.EmployeeId },
                                     new { @class = "btn btn-sm btn-outline-primary" })

                            @using (Html.BeginForm(
                                "DeleteEmployee", "Work",
                                new { id = employee.EmployeeId },
                                FormMethod.Post,
                                new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this employee?');">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            No employees found. Try another search.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>