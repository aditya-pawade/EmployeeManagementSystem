@{
    ViewBag.Title = "Dashboard";
    bool isAdmin = Session["Role"] as string == "Admin";
}

<div class="dashboard-welcome">
    <div>
        <span class="eyebrow">OVERVIEW</span>
        <h1>Welcome to PeopleDesk</h1>
        <p>Your employee workspace, all in one place.</p>
    </div>
    <div class="role-label">
        @if (isAdmin)
        {
            <span>Administrator</span>
        }
        else
        {
            <span>Employee</span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (isAdmin)
{
    <div class="stats-grid">
        <div class="panel-card stat-card">
            <span class="stat-label">Total Employees</span>
            <h2>@ViewBag.EmployeeCount</h2>
            <span class="text-muted">Employee records</span>
        </div>
    </div>
}

<h3 class="section-heading">Quick actions</h3>

<div class="dashboard-grid">
    @if (isAdmin)
    {
        <a class="dashboard-card"
           href="@Url.Action("Index", "Work")">
            <span class="dashboard-icon">01</span>
            <h3>Employee Directory</h3>
            <p>View, search and manage all employee records.</p>
            <span class="card-link">Open directory →</span>
        </a>

        <a class="dashboard-card"
           href="@Url.Action("CreateEmployee", "Work")">
            <span class="dashboard-icon">02</span>
            <h3>Add Employee</h3>
            <p>Create a new employee record.</p>
            <span class="card-link">Create record →</span>
        </a>
    }
    else
    {
        <a class="dashboard-card"
           href="@Url.Action("MyProfile", "Work")">
            <span class="dashboard-icon">01</span>
            <h3>My Profile</h3>
            <p>View your own employee information.</p>
            <span class="card-link">View profile →</span>
        </a>
    }

    <div class="dashboard-card">
        <span class="dashboard-icon">03</span>
        <h3>Account</h3>
        <p>Signed in as @Session["Role"].</p>

        @using (Html.BeginForm("Logout", "Account",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-primary">
                Sign out
            </button>
        }
    </div>
</div>